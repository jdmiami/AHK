# AHK · Artist House Karaoke — copy to apps/api/.env and apps/web/.env (or symlink) for local dev.
# Do not commit secrets. See packages/env/src/flags.ts (VKARA_ENV_DOCS) for VKARA_* docs.

# --- API (apps/api) ---
NODE_ENV=development
PORT=8000

PUBLIC_APP_URL=http://localhost:3000
# APP_PUBLIC_URL=
# WEB_ORIGIN=
# CORS_ORIGINS=http://localhost:3000,https://ahk.example

# Embed playability (true|false|1|0|yes|no|on|off — unset = default off)
# VKARA_EMBED_PREFILTER_AT_LIST=false
# VKARA_EMBED_CACHE_TTL_SECONDS=2592000

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

EMPTY_ROOM_TIMEOUT=3600
# SERVICE_REPORT_CRON=0 * * * *

LOG_TO_FILES=false
LOG_LEVEL=info
ERROR_LOG_PATH=logs/error.log
COMBINED_LOG_PATH=logs/combined.log

# --- Sentry (optional; leave unset to disable) ---
# Environments are ONLY: development | production (resolved automatically).
#   - local / Vercel preview  → development
#   - VERCEL_ENV=production   → production
# Explicit override still wins: SENTRY_ENVIRONMENT / NEXT_PUBLIC_SENTRY_ENVIRONMENT
# Create your own org + two projects (api, web) at https://sentry.io and paste the DSNs:
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_LOG_LEVELS=info,warn,error
# SENTRY_CRON_MONITORS=room-cleanup
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=1.0
# NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
# Source maps at build (web): SENTRY_AUTH_TOKEN (org:ci token), SENTRY_ORG, SENTRY_PROJECT
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_TIKTOK_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# VKARA_EXPERIMENTS=false
# NEXT_PUBLIC_VKARA_EXPERIMENTS=false

# Dev/WSL only — fixes UNKNOWN_CERTIFICATE_VERIFICATION_ERROR on some hosts.
# VKARA_TLS_INSECURE=true

# Playwright proxy (api-redis / TikTok experiments)
# CF_PROXY_TUNNEL_HOSTNAME=vkara-prx.example.giang.io.vn
# PLAYWRIGHT_PROXY_USERNAME=vkara
# PLAYWRIGHT_PROXY_PASSWORD=

# TikTok search session (experiments; API host)
# VKARA_TIKTOK_SEARCH_SESSION_TTL_SECONDS=600
# VKARA_TIKTOK_SEARCH_PAGE_SIZE=12
# VKARA_TIKTOK_SEARCH_MAX_DEVICE_SESSIONS=32
# VKARA_TIKTOK_SEARCH_PRUNE_INTERVAL_SECONDS=60

# Host switch (web, server-only): start/stop the RunPod pod that runs the API from the lobby.
# RUNPOD_API_KEY=
# RUNPOD_POD_ID=
# AHK_HOST_PIN=
# NEXT_PUBLIC_HOST_SWITCH=1

# VKARA_AIO=1
# GOOGLE_SITE_VERIFICATION=
# ANALYZE=true

# WHISPER_URL=
# HF_TOKEN=
